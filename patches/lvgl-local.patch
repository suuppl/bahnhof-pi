@@ -259,6 +259,16 @@ static void flush_cb(lv_display_t * disp, const lv_area_t * area, uint8_t * colo
         return;
     }
 
+    /* Local patch (bahnhofstafel): wait for vsync before writing to the
+     * single-buffered fb (vc4drmfb) to avoid tearing; harmless -1 if unsupported. */
