+#define FBIO_WAITFORVSYNC _IOW('F', 0x20, uint32_t)
+#endif
+    {
+        uint32_t crtc = 0;
+        (void)ioctl(dsc->fbfd, FBIO_WAITFORVSYNC, &crtc);
+    }
+
     int32_t w = lv_area_get_width(area);
